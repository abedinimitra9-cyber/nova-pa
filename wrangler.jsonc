{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-pa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "be36912f-9332-432e-8291-5acd3d4c8a53","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "617191c6c9dc41b3b1138cd6f19a9b2c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
